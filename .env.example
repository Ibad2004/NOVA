# Which LLM provider NOVA uses: ollama, gemini or groq
LLM_PROVIDER=ollama

# Agent loop limits
MAX_TOOL_STEPS=15
MAX_TOOL_RETRIES=2

# Ollama (local models, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=2048

# Gemini (get a key from Google AI Studio)
# Thinking tokens count toward GEMINI_MAX_TOKENS.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=8192
# Thinking budget when NOVA asks for thinking (-1 = dynamic)
# GEMINI_THINKING_BUDGET=-1

# Groq (get a key from the Groq console)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048
